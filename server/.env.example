# 飞书应用凭证（生产环境使用）
# 在 open.feishu.cn 创建应用后获取 App ID 和 App Secret
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 飞书多维表格 Base Token
FEISHU_BASE_TOKEN=JOKzbxJdlaKGz0sUlsnckcb76Fi

# 服务端口
PORT=3000

# ============================================================
# 说明：
# 1. TRAE 环境会自动注入用户访问令牌，无需填写 App Secret
# 2. 生产环境部署时，需要填写 App ID 和 App Secret
# 3. 创建飞书应用步骤请参考「部署指南.html」
# ============================================================
